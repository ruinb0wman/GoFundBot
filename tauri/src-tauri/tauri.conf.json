{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gofund-desktop",
  "version": "0.1.0",
  "identifier": "com.gofund.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "http://localhost:4173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GoFundBot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}