# ===========================================
# GoFundBot DataService 环境变量配置示例
#
# 使用说明：
# 1. 复制此文件为 .env：
#      cp .env.example .env
# 2. 根据需要修改配置
# 3. 不要将 .env 提交到 Git
# ===========================================

PORT=3100
NODE_ENV=development

# CORS 白名单（逗号分隔，生产环境请限制来源）
# 空值或 * 表示允许所有来源
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# 内存缓存最大条目数（默认 5000）
CACHE_MAX_ENTRIES=5000

# 日志输出目录（默认 ../Backend/Data/logs，与 Backend 共享）
LOG_DIR=../Backend/Data/logs

# stock-sdk 调用超时（毫秒，默认 10000）
STOCK_SDK_TIMEOUT_MS=10000

# 调试开关：设为 1 强制 stock-sdk 失败（测试 eastmoney 降级用）
# DATA_SERVICE_FORCE_STOCK_SDK_FAILURE=1
