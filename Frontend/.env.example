# API Fallback Base URL
# When Vite dev proxy is unavailable (e.g. direct backend access),
# the frontend falls back to this address.
# Default: http://localhost:5000
VITE_FALLBACK_API_BASE=http://localhost:5000

# API Base URL (when not using Vite proxy)
# Default: /api (Vite proxy handles routing)
VITE_API_BASE_URL=/api
